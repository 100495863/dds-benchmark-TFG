module Streaming {
    // Estructura para el Frame de Video
    struct VideoFrame {
        unsigned long frame_id;
        unsigned long long timestamp;
        unsigned short width;
        unsigned short height;
        sequence<octet> pixels;
    };

    // Estructura para el Fragmento de Audio
    struct AudioFrame {
        unsigned long frame_id;
        unsigned long long timestamp;
        unsigned short sample_rate;
        sequence<octet> samples;
    };
};
